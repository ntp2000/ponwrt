+package service
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestAirohaAPKProbeAndRepositoryRoot(t *testing.T) {
+	for _, root := range guideSoftSourceURLs {
+		for _, branch := range []string{"snapshots", "releases/25.12-SNAPSHOT"} {
+			u := root + branch + "/packages/aarch64_cortex-a53/base/packages.adb"
+			got, err := apkFeedProbeURL("# " + u + ".asc\n \t" + u + "\r\n")
+			if err != nil || got != u {
+				t.Fatalf("probe = %q, %v", got, err)
+			}
+			got, err = getApkDistFeedUrlByContent(u)
+			if err != nil || got != root {
+				t.Fatalf("root = %q, %v, want %q", got, err, root)
+			}
+		}
+	}
+	for _, bad := range []string{
+		"", "# https://test/base/packages.adb", "https://test/base/packages.adb.asc",
+		"file:///base/packages.adb", "https://user:secret@test/base/packages.adb",
+		"https://test/'/base/packages.adb", "https://test/base/packages.adb?x=1",
+	} {
+		if u, err := apkFeedProbeURL(bad); err == nil {
+			t.Fatalf("accepted malformed probe %q", u)
+		}
+	}
+}
+
+func TestAirohaSourceSwitchPreservesBranchThirdPartyAndLiveEdits(t *testing.T) {
+	dir := t.TempDir()
+	target, rom := filepath.Join(dir, "live"), filepath.Join(dir, "rom")
+	zju, official := guideSoftSourceURLs[0], guideSoftSourceURLs[1]
+	base := "snapshots/packages/aarch64_cortex-a53/base/packages.adb"
+	keep := "# " + official + base + "\n" +
+		"https://istore.istoreos.com/repo-apk/all/store/packages.adb\n" +
+		"file:///my-repo/packages.adb\n" +
+		official + "releases/25.12-SNAPSHOT/packages/aarch64_cortex-a53/base/packages.adb\n" +
+		official + "snapshots/packages/aarch64_cortex-a53/nas/packages.adb\n"
+	live := official + base + "\n" + keep
+	if err := os.WriteFile(target, []byte(live), 0600); err != nil { t.Fatal(err) }
+	if err := os.WriteFile(rom, []byte("do not restore this"), 0644); err != nil { t.Fatal(err) }
+	if err := replaceGuideSoftSource(zju, rom, target); err != nil { t.Fatal(err) }
+	result, _ := os.ReadFile(target)
+	if string(result) != zju+base+"\n"+keep { t.Fatalf("unexpected replacement: %s", result) }
+	info, _ := os.Stat(target)
+	if info.Mode().Perm() != 0600 { t.Fatal("lost permissions") }
+	if err := replaceGuideSoftSource(official, rom, target); err != nil { t.Fatal(err) }
+	result, _ = os.ReadFile(target)
+	if string(result) != live { t.Fatal("mirror switch is not reversible") }
+	if err := replaceGuideSoftSource("https://evil.invalid/", rom, target); err == nil {
+		t.Fatal("accepted unknown mirror")
+	}
+	result, _ = os.ReadFile(target)
+	if string(result) != live { t.Fatal("failed switch modified live file") }
+	left, _ := filepath.Glob(filepath.Join(dir, ".quickstart-feeds-*"))
+	if len(left) != 0 { t.Fatal("temporary file remains") }
+}
+
+func TestAirohaCatalogDoesNotOfferOpenWrtOrUnavailableMirrors(t *testing.T) {
+	if len(guideSoftSourceIdentities) != 2 { t.Fatal("unexpected catalog") }
+	for _, root := range guideSoftSourceURLs {
+		if strings.Contains(root, "/openwrt") || strings.Contains(root, "ustc") {
+			t.Fatalf("incorrect default catalog URL %s", root)
+		}
+	}
+}
