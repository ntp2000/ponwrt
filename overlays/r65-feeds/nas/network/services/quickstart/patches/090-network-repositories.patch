+func apkFeedProbeURL(content string) (string, error) {
+	for _, line := range strings.Split(content, "\n") {
+		line = strings.TrimSpace(line)
+		if strings.HasPrefix(line, "#") || !strings.HasSuffix(line, "/base/packages.adb") {
+			continue
+		}
+		parsed, err := url.Parse(line)
+		if err == nil && (parsed.Scheme == "https" || parsed.Scheme == "http") &&
+			parsed.Host != "" && parsed.User == nil && parsed.RawQuery == "" &&
+			parsed.Fragment == "" && !strings.ContainsAny(line, "'\"\\ \t\r\n") {
+			// APK v3 signatures are embedded in the ADB, not in a sidecar .asc.
+			return line, nil
+		}
+	}
+	return "", errors.New("apk feed not found")
