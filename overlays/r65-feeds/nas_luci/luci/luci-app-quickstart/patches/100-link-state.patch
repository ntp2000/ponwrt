@@ -0,0 +1,13 @@
+export function linkStatus(state: unknown): 'connected' | 'disconnected' | 'unknown' {
+    const value = typeof state === 'string' ? state.trim().toUpperCase() : '';
+    switch (value) {
+        case 'UP':
+            return 'connected';
+        case 'DOWN':
+        case 'LOWERLAYERDOWN':
+        case 'NOTPRESENT':
+            return 'disconnected';
+        default:
+            return 'unknown';
+    }
+}
