+import { linkStatus } from './link-state';
+
+export const DETECT_TIMEOUT = 30000;
+export const PORT_FRESHNESS = 6000;
+const terminal = new Set(['netSuccess', 'netFailed', 'dnsFailed', 'softSourceFailed']);
+
+export function networkState() {
+    return {
+        status: {} as NetworkStatus,
+        lastTerminalNetworkStatus: null as NetworkStatus | null,
+        networkDetectingSince: null as number | null,
+        awaitingWanRecovery: false,
+        wanLinkDown: false,
+        portList: [] as NetworkPort[],
+        portListUpdatedAt: null as number | null,
+        clock: 0,
+    };
+}
+type State = ReturnType<typeof networkState>;
+
+function startDetecting(state: State, now: number) {
+    if (state.networkDetectingSince === null) state.networkDetectingSince = now;
+}
+
+export function updateNetwork(state: State, value: unknown, now: number) {
+    state.clock = now;
+    if (!value || typeof value !== 'object' || Array.isArray(value)
+        || typeof (value as NetworkStatus).networkInfo !== 'string') {
+        networkFailure(state, now);
+        return;
+    }
+    const status = value as NetworkStatus;
+    state.status = { ...status };
+    if (terminal.has(status.networkInfo!)) {
+        // A physical-down override must never become a backend terminal result.
+        if (!state.wanLinkDown) {
+            state.lastTerminalNetworkStatus = { ...status };
+            state.networkDetectingSince = null;
+            state.awaitingWanRecovery = false;
+        }
+    } else {
+        startDetecting(state, now);
+    }
+    updateWan(state, now);
+}
+
+export function networkFailure(state: State, now: number) {
+    state.clock = now;
+    startDetecting(state, now);
+    state.status = { ...state.status, networkInfo: 'netDetecting' };
+}
+
+function updateWan(state: State, now: number) {
+    const iface = state.status.defaultInterface || state.lastTerminalNetworkStatus?.defaultInterface;
+    const fresh = state.portListUpdatedAt !== null && now - state.portListUpdatedAt < PORT_FRESHNESS;
+    const matching = fresh && iface ? state.portList.filter(port =>
+        port.name === iface || port.master === iface
+        || (Array.isArray(port.interfaceNames) && port.interfaceNames.includes(iface))) : [];
+    const down = matching.length > 0 && matching.every(port => linkStatus(port.linkState) === 'disconnected');
+    const recovered = matching.some(port => linkStatus(port.linkState) === 'connected');
+    if (state.wanLinkDown && recovered) {
+        state.awaitingWanRecovery = true;
+        state.networkDetectingSince = now;
+        state.status = { ...state.status, networkInfo: 'netDetecting' };
+    }
+    // Expired/unknown samples do not count as proof of link recovery.
+    if (state.wanLinkDown && !down && !recovered) {
+        state.awaitingWanRecovery = true;
+        startDetecting(state, now);
+    }
+    state.wanLinkDown = down;
+}
+
+export function updatePorts(state: State, ports: unknown, now: number) {
+    state.clock = now;
+    if (!Array.isArray(ports) || !ports.every(p => p && typeof p === 'object'
+        && typeof p.name === 'string')) return;
+    state.portList = ports;
+    state.portListUpdatedAt = now;
+    updateWan(state, now);
+}
+
+export function tickNetwork(state: State, now: number) {
+    state.clock = now;
+    updateWan(state, now);
+}
+
+export function displayNetwork(state: State): NetworkStatus {
+    const pending = state.networkDetectingSince !== null;
+    const timedOut = pending && state.clock - state.networkDetectingSince! >= DETECT_TIMEOUT;
+    let info = state.status.networkInfo;
+    if (state.wanLinkDown) info = 'netFailed';
+    else if (state.awaitingWanRecovery) info = timedOut ? 'netFailed' : 'netDetecting';
+    else if (pending || !terminal.has(info || '')) {
+        const last = state.lastTerminalNetworkStatus?.networkInfo;
+        info = last && (last !== 'netSuccess' || !timedOut)
+            ? last : timedOut ? 'netFailed' : 'netDetecting';
+    }
+    const previous = pending || state.wanLinkDown || state.awaitingWanRecovery
+        ? state.lastTerminalNetworkStatus : null;
+    return { ...previous, ...state.status, networkInfo: info, internetConnected: info === 'netSuccess' };
+}
+
+export function networkPollDelay(state: State): number {
+    return state.networkDetectingSince !== null
+        && state.clock - state.networkDetectingSince < DETECT_TIMEOUT ? 1000 : 5000;
+}
