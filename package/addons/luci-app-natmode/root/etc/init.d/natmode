#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
#
# natmode —— 开机应用 NAT 模式；firewall 重载后重建 nft 规则
#
# START=25 必须晚于 firewall（START=19）：
#   fw4 每次 reload 会重建整张 ruleset，插入的 fully-random 规则随之消失。
#   若本服务早于 firewall 启动，规则会被随后的 fw4 冲掉。

# START/STOP/USE_PROCD 是 /etc/rc.common 框架约定的变量，shellcheck 不认识
# shellcheck disable=SC2034
START=25
STOP=90

USE_PROCD=1

start_service() {
	# 必须开一个实例，否则 procd 不会把 service_triggers 里的
	# reload 触发器真正注册上（触发器挂在实例上），
	# firewall 变化时就不会回调本服务。
	procd_open_instance
	procd_close_instance

	/usr/sbin/natmode-apply apply >/dev/null 2>&1
}

# firewall 重载后被回调：
# 只重建 nft 规则（reapply），不写 firewall UCI ——
# 否则会把用户在防火墙页面的改动反向覆盖回去。
reload_service() {
	/usr/sbin/natmode-apply reapply >/dev/null 2>&1
}

stop_service() {
	# 卸载时仅清理本插件注入的 nft 规则，不动 firewall / natmode UCI。
	# fullcone 开关按用户在防火墙页面的设置保留。
	# 不能用 reapply：reapply 会按当前 mode 重建规则，等于「停了服务效果还在」。
	/usr/sbin/natmode-apply cleanup >/dev/null 2>&1
	return 0
}

# 不重载 boot()：让 rc.common 默认 boot → start 接管。
# 这样 start_service 里的 procd_open_instance 会执行，
# service_triggers 中的 firewall reload 触发器才能挂上。
# 否则开机后 NAT 模式这一次性能应用，但 fw4 reload 冲掉 NAT4 规则后
# 不会自动 reapply —— 整个自动重建机制开机后是哑的。

service_triggers() {
	# firewall 配置变化（含在防火墙页面点保存并应用）时回调 reload_service
	procd_add_reload_trigger firewall
	procd_add_reload_trigger natmode
}
