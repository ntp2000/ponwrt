#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# natmode-apply —— 应用 / 查询当前 NAT 模式
#
# 用法：
#   natmode-apply apply [mode] [fullcone6] [auto_offload]
#                            应用模式；LuCI 保存时显式传参（见 do_apply 注释），
#                            开机/init.d 路径不传参、读 UCI 现值
#   natmode-apply reapply    只重建 nft 层规则（不写 firewall UCI），
#                            供 firewall 重载后调用（init.d 的 reload 触发）
#   natmode-apply status     输出当前状态；同时做两件事：
#                            1) 反向同步：若 firewall 的 FullCone 开关被外部
#                               （网络 → 防火墙 → 常规设置）改动，把实际生效的
#                               模式写回 natmode.main.mode，使本页与防火墙一致
#                            2) 自愈：若模式是 symmetric 但 nft 规则不存在
#                               （被 fw4 reload 冲掉），自动重新注入
#
# ─────────────────────────────────────────────────────────────
# 三档实现原理
# ─────────────────────────────────────────────────────────────
#   fullcone (NAT1)
#     firewall4 的 defaults.fullcone=1。fw4 在 srcnat/dstnat 生成 fullcone
#     表达式，内核 kmod-nft-fullcone 维护第二张哈希表（按转换后 3-tuple 索引），
#     实现「端点无关映射 + 端点无关过滤」。
#
#   restricted (NAT3)
#     defaults.fullcone=0，走 fw4 原生 masquerade。Linux netfilter 的
#     masquerade 会尽量复用同一公网端口（端点无关映射），但入站只放行
#     「内网主动联系过的 IP:端口」（地址+端口相关过滤），
#     即 RFC 3489 的 Port Restricted Cone = NAT3。
#     ⚠️ 标准 netfilter 做不出精确的 NAT2（仅地址受限、端口不受限）。
#
#   symmetric (NAT4)
#     defaults.fullcone=0，并在 fw4 的每个 srcnat_<zone> 链首插入
#       meta nfproto ipv4 masquerade fully-random
#     每条新连接完全随机选源端口 → 映射不可预测，打洞基本失败。
#     ⚠️ 这是「随机端口」，不是 RFC 定义的「按目的地独立映射」，
#        但对 P2P / STUN 的效果等同对称型 NAT4。
#
# ─────────────────────────────────────────────────────────────
# 两个关键坑（本脚本已处理）
# ─────────────────────────────────────────────────────────────
#   坑 1：nft 规则被 fw4 reload 冲掉
#     fw4 每次 reload 都会重建整张 ruleset，插入的 fully-random 规则随之消失。
#     而 fullcone 是 UCI 驱动、fw4 自己生成的，不受影响 —— 这正是
#     「NAT1 能生效、NAT4 不生效」的根因。
#     对策：
#       a) init.d 挂 procd 触发器，firewall 变化时自动 reapply；
#       b) status 里做自愈，打开页面即自动补回规则。
#
#   坑 2：硬件/软件卸载让 NAT4 不可观测
#     flow offload（尤其硬件卸载走 PPE）会把流量绕过 conntrack 直接转发，
#     nft 的 masquerade 规则根本不参与，随机端口无从谈起。
#     对策：应用 symmetric 时按 auto_offload 选项自动关闭卸载（默认开），
#           否则 NAT4 只是「配置上了」但测不出来。

CONF_MODE="natmode.main.mode"
CONF_OFFLOAD="natmode.main.auto_offload"
CONF_FULLCONE6="natmode.main.fullcone6"

log() {
	logger -t natmode "$@"
}

# ─────────────────────────────────────────────────────────────
# 基础读写
# ─────────────────────────────────────────────────────────────
get_mode() {
	m="$(uci -q get "$CONF_MODE" 2>/dev/null)"
	case "$m" in
		fullcone|restricted|symmetric) echo "$m" ;;
		*) echo "fullcone" ;;
	esac
}

get_flag() {  # get_flag <uci_key> <default>
	local v
	v="$(uci -q get "$1" 2>/dev/null)"
	case "$v" in
		1|on|true|enabled) echo 1 ;;
		0|off|false|disabled) echo 0 ;;
		*) echo "${2:-0}" ;;
	esac
}

# 写入 firewall 的 fullcone 开关，行为与防火墙页面完全一致。
#
# 防火墙页（网络 → 防火墙 → 常规设置）的实际动作是：
#   勾选   → uci set firewall.cfgXXXXXX.fullcone='1'
#   取消   → uci del firewall.cfgXXXXXX.fullcone
#            uci del firewall.cfgXXXXXX.fullcone6
#            uci del firewall.cfgXXXXXX.syn_flood
#            uci set firewall.cfgXXXXXX.synflood_protect='1'
# 即「取消」用的是 del（把键删掉），不是 set 0。
# 这里对齐该行为，并一并处理 IPv6 的 fullcone6（之前漏了）。
set_fullcone_exact() {
	local val="$1"

	if [ "$val" = "1" ]; then
		uci set firewall.@defaults[0].fullcone='1' 2>/dev/null || return 1
		# IPv6 的 fullcone6 由独立选项控制（默认关闭）
		if [ "$(get_flag "$CONF_FULLCONE6" 0)" = "1" ]; then
			uci set firewall.@defaults[0].fullcone6='1' 2>/dev/null
			log "firewall fullcone=1（IPv6 fullcone6 一并开启）"
		else
			uci -q del firewall.@defaults[0].fullcone6
			log "firewall fullcone=1（IPv6 fullcone6 未开启，默认关闭）"
		fi
	else
		# 与防火墙页取消勾选一致：删键，而不是写 0
		uci -q del firewall.@defaults[0].fullcone
		uci -q del firewall.@defaults[0].fullcone6
		log "firewall fullcone 已删除（与防火墙页取消勾选一致，含 fullcone6）"
	fi
	uci commit firewall
	return 0
}

# 读取 fullcone6 选项当前值（0/1）
get_fullcone6() {
	get_flag "$CONF_FULLCONE6" 0
}

offload_state() {  # 输出 off / sw / hw
	if [ "$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null)" = "1" ]; then
		if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)" = "1" ]; then
			echo hw
		else
			echo sw
		fi
	else
		echo off
	fi
}

offload_disable() {
	if [ "$(offload_state)" != "off" ]; then
		uci set firewall.@defaults[0].flow_offloading='0' 2>/dev/null
		uci set firewall.@defaults[0].flow_offloading_hw='0' 2>/dev/null
		uci commit firewall
		log "应用 NAT4：已关闭路由/NAT 卸载（否则随机端口不生效）"
	fi
}

# ─────────────────────────────────────────────────────────────
# nft 层：fully-random 规则的增删与统计
#
# fw4 的链命名（root/usr/share/firewall4/templates/ruleset.uc）：
#   chain srcnat_<zone.name> { ... masquerade ... }
# 只处理 srcnat_<name>（带下划线，即 per-zone 链）。
# 绝不碰裸 `srcnat` 链 —— 那里没有 oifname 限定，插入裸 masquerade
# 会把 LAN→LAN 的流量也做 NAT。
# ─────────────────────────────────────────────────────────────
nft_srcnat_chains() {
	local out
	out="$(nft list chains inet fw4 2>/dev/null)"
	# 某些 nft 版本的 `list chains` 输出为空，回退到整表 dump
	[ -z "$out" ] && out="$(nft list table inet fw4 2>/dev/null)"
	printf '%s\n' "$out" | \
		sed -n 's/^[[:space:]]*chain \(srcnat_[A-Za-z0-9_]*\).*/\1/p' | sort -u
}

nft_random_count() {
	local n=0 ch
	for ch in $(nft_srcnat_chains); do
		c="$(nft list chain inet fw4 "$ch" 2>/dev/null | grep -c 'fully-random')"
		n=$((n + ${c:-0}))
	done
	echo "$n"
}

nft_random_add() {
	local ch added=0
	for ch in $(nft_srcnat_chains); do
		nft list chain inet fw4 "$ch" 2>/dev/null | grep -q 'fully-random' && continue
		if nft insert rule inet fw4 "$ch" \
			meta nfproto ipv4 masquerade fully-random 2>/dev/null; then
			added=$((added + 1))
			log "已插入 fully-random 到 $ch"
		else
			log "警告：插入 $ch 失败"
		fi
	done
	echo "$added"
}

nft_random_del() {
	local ch h
	for ch in $(nft_srcnat_chains); do
		# 取该链上【所有】fully-random 规则的 handle 逐个删除。
		# 原实现只取 head -1（第一条），若链里残留多条就删不干净 ——
		# 表现为「当前模式=受限型 NAT3，但随机端口规则=1 条」的
		# 不一致状态，实际 NAT 行为既不是干净 NAT3 也不是 NAT4。
		for h in $(nft -a list chain inet fw4 "$ch" 2>/dev/null | \
		           grep 'fully-random' | grep -oE 'handle [0-9]+' | \
		           awk '{print $2}'); do
			nft delete rule inet fw4 "$ch" handle "$h" 2>/dev/null
		done
	done
}

fw_reload() {
	/etc/init.d/firewall reload >/dev/null 2>&1 || fw4 reload >/dev/null 2>&1
}

# ─────────────────────────────────────────────────────────────
# 生效模式反推：从「实际 UCI / nftables 状态」算出当前真实模式
# ─────────────────────────────────────────────────────────────
detect_effective() {
	local fc rand
	fc="$(uci -q get firewall.@defaults[0].fullcone 2>/dev/null)"
	rand="$(nft_random_count)"

	if [ "${fc:-0}" = "1" ]; then
		echo "fullcone"
	elif [ "${rand:-0}" != "0" ]; then
		echo "symmetric"
	else
		echo "restricted"
	fi
}

# ─────────────────────────────────────────────────────────────
# ensure_module：全锥形时确保 nft_fullcone 已加载
#
# 防火墙页那个「启用 FullCone NAT」复选框的显示条件是
#   L.hasSystemFeature('fullcone')
# 而该判定（luci-base 的 rpcd ucode 插件）是
#   access('/sys/module/nft_fullcone/refcnt')
# 即模块没加载时选项根本不显示 —— 存在「没开 fullcone → 模块没加载 →
# 选项不显示 → 没法在防火墙页打开」的鸡生蛋问题。
# 这里主动 modprobe，保证该选项始终可见可用。
# ─────────────────────────────────────────────────────────────
ensure_module() {
	if [ -d /sys/module/nft_fullcone ] || lsmod 2>/dev/null | grep -q nft_fullcone; then
		return 0
	fi
	modprobe nft_fullcone >/dev/null 2>&1 && \
		log "已加载 nft_fullcone 模块（使防火墙页 FullCone 选项可见）"
}

# ─────────────────────────────────────────────────────────────
# sync：firewall → natmode 反向同步
#
# 网络 → 防火墙 → 常规设置 里的「启用 FullCone NAT」写的就是
# firewall.@defaults[0].fullcone，与本插件同一个 UCI 键。
# 在那边改动只会改 firewall，不会动 natmode.main.mode。
#
# ⚠️ 关键限制：firewall.fullcone 只有「1 / 空」两种状态，
#    而 natmode 有三档。空 = 可能是 restricted 也可能是 symmetric。
#    且 nft 随机端口规则在 fw4 reload 后已被冲掉，无法据此区分。
#    因此这里【只处理无歧义的两种情况】，其余一律保持 natmode 原值不动。
#
#    早期版本用 detect_effective() 强行覆盖，结果在保存流程中
#    （apply 尚未执行、fullcone 还是 1）把刚选的对称型改回全锥形，
#    表现为「插件里改不了 NAT 类型」。
#
# 返回：0=有同步发生，1=本来就一致（或存在歧义、保持不动）
# ─────────────────────────────────────────────────────────────
do_sync() {
	local mode fc
	mode="$(get_mode)"
	fc="$(uci -q get firewall.@defaults[0].fullcone 2>/dev/null)"
	fc="${fc:-0}"

	# 情况一（无歧义）：fullcone=1 → 一定是全锥形。
	# 开了 fullcone 就不可能是 NAT3/NAT4。
	if [ "$fc" = "1" ] && [ "$mode" != "fullcone" ]; then
		uci set "$CONF_MODE"="fullcone" 2>/dev/null && uci commit natmode
		ensure_module
		log "同步（防火墙 → 本页）：$mode -> fullcone"
		echo "fullcone"
		return 0
	fi

	# 情况二（无歧义）：fullcone 已关闭，而 natmode 仍是 fullcone
	# → 说明本页记录已过期，降为 restricted。
	if [ "$fc" != "1" ] && [ "$mode" = "fullcone" ]; then
		uci set "$CONF_MODE"="restricted" 2>/dev/null && uci commit natmode
		log "同步（防火墙 → 本页）：fullcone -> restricted"
		echo "restricted"
		return 0
	fi

	# 情况三（有歧义）：fullcone 关闭 + natmode 是 restricted/symmetric
	# → 无法区分，保持 natmode 原值。natmode.main.mode 是唯一可靠记录。
	echo "$mode"
	return 1
}

# ─────────────────────────────────────────────────────────────
# apply：按模式真正落地（natmode → firewall 方向）
#
# 用法：
#   natmode-apply apply                                  开机/init.d 用：读 UCI 现值
#   natmode-apply apply <mode> [<fullcone6>] [<auto_offload>]
#       LuCI 页面保存时用：mode ∈ fullcone|restricted|symmetric，
#       fullcone6 / auto_offload ∈ 0|1，与页面上点选的值一致。
#
# 为什么必须传参（实测踩坑，别删）：
#   LuCI 的 UCI 改动经 rpcd 暂存，要等 ui.changes.apply() 才提交；
#   而本脚本在提交【之前】运行，CLI uci 读不到暂存值 ——
#   apply 若依赖读 UCI 获取新模式，拿到的是上一次的旧值
#   （实测：选 NAT3 应用后实际应用的仍是 fullcone，随后 commit 落地
#   restricted，又被 do_sync 以「firewall 仍是 fullcone=1」强制改回，
#   表现为「怎么点都不生效」）。
#   传参后本脚本成为唯一权威写入方：先把 mode/开关写进 UCI 并提交
#   （幂等，与 rpcd 之后的同值提交不冲突），再落地 firewall。
# ─────────────────────────────────────────────────────────────
do_apply() {
	local want="$1" want6="$2" wantoff="$3"
	local mode

	case "$want" in
		fullcone|restricted|symmetric)
			uci set "$CONF_MODE"="$want" 2>/dev/null
			;;
		'')
			: # 开机路径：不传参，用 UCI 现值
			;;
		*)
			log "警告：忽略未知模式参数 '$want'，使用 UCI 现值"
			;;
	esac
	case "$want6" in
		0|1) uci set "$CONF_FULLCONE6"="$want6" 2>/dev/null ;;
	esac
	case "$wantoff" in
		0|1) uci set "$CONF_OFFLOAD"="$wantoff" 2>/dev/null ;;
	esac
	# 有无参数改动都提交一次：顺带把暂存的同名改动冲掉，保证下方
	# get_mode / get_flag 读到的是刚写入的权威值
	uci commit natmode 2>/dev/null

	mode="$(get_mode)"

	case "$mode" in
		fullcone)
			set_fullcone_exact 1
			nft_random_del
			ensure_module
			;;
		restricted)
			set_fullcone_exact 0
			nft_random_del
			;;
		symmetric)
			set_fullcone_exact 0
			# 卸载与 NAT4 互斥：开着卸载，随机端口规则根本不参与转发
			[ "$(get_flag "$CONF_OFFLOAD" 1)" = "1" ] && offload_disable
			;;
	esac

	# 先 reload 让 fullcone / 卸载开关生效，再插入 nft 规则
	# （顺序反了的话，reload 会把刚插的规则冲掉）
	fw_reload

	# reload 之后再清一次：确保非 NAT4 模式下没有任何残留随机端口规则
	if [ "$mode" = "symmetric" ]; then
		nft_random_add >/dev/null
	else
		nft_random_del
	fi

	log "NAT 模式已应用（本页 → 防火墙）：$mode"
	echo "$mode"
}

# ─────────────────────────────────────────────────────────────
# reapply：只按「当前实际状态」重建 nft 规则，不写 firewall UCI。
# 供 firewall 重载后调用 —— 避免与用户在防火墙页面的改动互相打架。
# ─────────────────────────────────────────────────────────────
do_reapply() {
	local mode fc

	# 防火墙刚被改动/重载过 → 先把 firewall 侧的变化同步回本页
	# （这样即使不打开 NAT 类型页，两边 UCI 也保持一致）
	do_sync >/dev/null 2>&1
	mode="$(get_mode)"
	fc="$(uci -q get firewall.@defaults[0].fullcone 2>/dev/null)"

	if [ "$mode" = "symmetric" ] && [ "${fc:-0}" != "1" ]; then
		nft_random_add >/dev/null
		log "firewall 重载后已重建 NAT4 随机端口规则"
	else
		nft_random_del
	fi
}

# ─────────────────────────────────────────────────────────────
# status：输出状态 + 反向同步 + 自愈
# ─────────────────────────────────────────────────────────────
do_status() {
	local mode fc effective rand chains synced=0 healed=0
	mode="$(get_mode)"
	fc="$(uci -q get firewall.@defaults[0].fullcone 2>/dev/null)"
	fc="${fc:-0}"
	chains="$(nft_srcnat_chains | wc -l | tr -d ' ')"
	chains="${chains:-0}"
	rand="$(nft_random_count)"

	# ── 自愈：symmetric 但规则没了（被 fw4 reload 冲掉）就补回 ──
	if [ "$mode" = "symmetric" ] && [ "$fc" != "1" ] && [ "${rand:-0}" = "0" ] \
	   && [ "${chains:-0}" != "0" ]; then
		nft_random_add >/dev/null
		rand="$(nft_random_count)"
		healed=1
		log "自愈：NAT4 随机端口规则已重新注入"
	fi

	# ── 反向同步（自愈之后调用，此时 detect 才可靠）──
	# 注意：自愈必须放在同步之前。若先同步，nft 规则还没重建，
	# symmetric 会被误判成 restricted。
	effective="$(do_sync)"
	synced=0
	if [ "$mode" != "$effective" ]; then
		synced=1
	fi

	# 同步后若落到 symmetric 而规则仍缺失，再补一次
	if [ "$effective" = "symmetric" ] && [ "${rand:-0}" = "0" ] \
	   && [ "${chains:-0}" != "0" ] && [ "$healed" = "0" ]; then
		nft_random_add >/dev/null
		rand="$(nft_random_count)"
		healed=1
		log "自愈（同步后）：NAT4 随机端口规则已重新注入"
	fi

	# ── 反向自愈：非 NAT4 模式却残留随机端口规则 → 清理 ──
	# 典型触发路径：先前是 NAT4（已注入规则），随后在防火墙页取消勾选
	# FullCone → do_sync 把 mode 改成 restricted，但 do_sync 不碰 nft，
	# 于是出现「模式=NAT3、随机端口规则=1 条」的不一致状态，
	# 实际行为既不是干净 NAT3 也不是 NAT4。
	if [ "$effective" != "symmetric" ] && [ "${rand:-0}" != "0" ]; then
		nft_random_del
		rand="$(nft_random_count)"
		healed=1
		log "自愈：清理残留随机端口规则（当前为 $effective，不应存在）"
	fi

	# 防火墙页「启用 FullCone NAT」复选框此刻的勾选状态
	# （同一个 UCI 键，直接就是 firewall.@defaults[0].fullcone）
	fw_mode="restricted"
	[ "$fc" = "1" ] && fw_mode="fullcone"

	echo "mode=$effective"
	echo "effective=$effective"
	echo "fw_mode=$fw_mode"
	echo "fullcone=$fc"
	echo "fullcone6=$(uci -q get firewall.@defaults[0].fullcone6 2>/dev/null || echo 0)"
	echo "fullcone6_opt=$(get_fullcone6)"
	echo "random_rules=${rand:-0}"
	echo "srcnat_chains=${chains:-0}"
	echo "offload=$(offload_state)"
	echo "synced=$synced"
	echo "healed=$healed"

	if [ -d /sys/module/nft_fullcone ] || \
	   lsmod 2>/dev/null | grep -q nft_fullcone; then
		echo "module=loaded"
	else
		echo "module=missing"
	fi
}

case "$1" in
	apply)   shift; do_apply "$@" ;;
	reapply) do_reapply ;;
	status)  do_status ;;
	sync)    do_sync ;;
	cleanup) nft_random_del ;;
	*)
		echo "用法: natmode-apply [apply|reapply|status|sync|cleanup]"
		echo "  apply    本页 → 防火墙：按模式落地"
		echo "           apply <mode> [<fullcone6>] [<auto_offload>]"
		echo "           LuCI 保存时显式传参（rpcd 暂存值 CLI 读不到，见 do_apply 注释）"
		echo "  reapply  防火墙重载后：同步 UCI + 重建 nft 规则"
		echo "  status   输出状态，并做自愈与反向同步"
		echo "  sync     防火墙 → 本页：把实际生效模式写回 natmode.main.mode"
		echo "  cleanup  仅删除本插件注入的 nft 随机端口规则，不动 UCI"
		echo "           （供 init.d stop_service 调用）"
		exit 1
		;;
esac

exit 0
