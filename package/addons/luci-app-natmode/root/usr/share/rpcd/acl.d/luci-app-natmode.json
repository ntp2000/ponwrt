{
	"luci-app-natmode": {
		"description": "Grant access to NAT mode selector",
		"read": {
			"uci": [ "natmode", "firewall" ],
			"file": {
				"/usr/sbin/natmode-apply": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "natmode", "firewall" ],
			"file": {
				"/usr/sbin/natmode-apply": [ "exec" ]
			}
		}
	}
}